# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-lite

# Generation providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# Set to 1 when the model is already cached locally and Hugging Face HEAD requests are blocked.
HF_LOCAL_FILES_ONLY=0

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
